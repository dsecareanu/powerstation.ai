{
  "name": "@powerstation/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared UI for powerstation.ai: design tokens, data-state styles and Preact components.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./fonts/*": "./src/fonts/*",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.tsx",
    "demo": "vite demo",
    "size": "tsx scripts/size.ts"
  },
  "dependencies": {
    "@powerstation/schema": "workspace:*"
  },
  "peerDependencies": {
    "preact": ">=10.27.0 <12"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "esbuild": "^0.28.2",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.8.3",
    "vite": "^8.3.8"
  }
}
