// Assets-only Worker that serves https://powerstation.ai.
// Guard (scripts/check-worker.ts): the name must stay "powerstation-site", "workers_dev"
// must stay false (no workers.dev address), and this file must have no routes, no custom
// domains, no "env" blocks and no Worker script.
// The custom domain powerstation.ai is attached to this Worker through the Cloudflare API,
// not here. wrangler deploy leaves it alone when this file lists no routes.
// The same Cloudflare account hosts "domain-landers" (13 domains). Never deploy to it.
// Comments in this file must be on their own line.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "powerstation-site",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
