{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerstation.ai/schema/v1/zones.schema.json",
  "title": "ZonesFile",
  "description": "v1/meta/zones.json. Bidding zones (data is stored per zone) and countries (the UI shows countries), with the mapping between them.",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/Envelope" }],
  "required": ["dataset", "zones", "countries"],
  "unevaluatedProperties": false,
  "properties": {
    "dataset": { "const": "zones" },
    "zones": { "type": "array", "items": { "$ref": "#/$defs/Zone" } },
    "countries": { "type": "array", "items": { "$ref": "#/$defs/Country" } }
  },
  "$defs": {
    "LatLon": {
      "title": "LatLon",
      "type": "object",
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "Zone": {
      "title": "Zone",
      "type": "object",
      "required": ["id", "name", "countries", "centroid", "neighbours"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/ZoneId" },
        "name": { "type": "string", "minLength": 1 },
        "eic": {
          "description": "ENTSO-E EIC area code, e.g. 10Y1001A1001A82H.",
          "type": "string",
          "pattern": "^[0-9A-Z-]{16}$"
        },
        "countries": {
          "description": "Countries this zone is part of. Usually one; DE-LU has two.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/CountryCode" }
        },
        "centroid": { "$ref": "#/$defs/LatLon" },
        "neighbours": {
          "description": "Zones with a direct interconnection. Only zones listed in this file.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/ZoneId" }
        }
      }
    },
    "Country": {
      "title": "Country",
      "type": "object",
      "required": ["code", "name", "zones"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "common.schema.json#/$defs/CountryCode" },
        "name": { "type": "string", "minLength": 1 },
        "zones": {
          "description": "Bidding zones in this country. Italy and Norway have several.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/ZoneId" }
        }
      }
    }
  }
}
