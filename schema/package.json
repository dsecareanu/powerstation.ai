{
  "name": "@powerstation/schema",
  "version": "1.2.0",
  "private": true,
  "description": "Data contract for powerstation.ai: JSON Schema, generated TypeScript types and a validator.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./validate": "./src/validate.ts",
    "./json/*": "./json/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "types": "tsx scripts/generate-types.ts",
    "types:check": "tsx scripts/generate-types.ts --check",
    "validate": "tsx scripts/validate-cli.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
