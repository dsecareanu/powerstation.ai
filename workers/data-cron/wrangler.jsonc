// Worker "powerstation-data-cron". See index.js for what it does.
// No public address: workers_dev and preview_urls are off, and there are no routes.
// Deployed on 2026-11-25 through the Cloudflare API with the same settings as this file.
// Never deploy to "domain-landers" or "powerstation-site" from here.
{
  "name": "powerstation-data-cron",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
